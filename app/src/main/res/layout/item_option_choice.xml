<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/choiceRow"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/option_choice_bg"
    android:paddingHorizontal="12dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_circle_unchecked" />

    <TextView
        android:id="@+id/tvChoiceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:text="Barbecue" />

    <TextView
        android:id="@+id/tvChoicePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ios_red"
        android:text="+20 MRU" />

</LinearLayout>